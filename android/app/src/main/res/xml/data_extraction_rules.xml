<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the phone key lives in Android Keystore and cannot be moved, so
     restored metadata would point at a key that does not exist. allowBackup="false" stops
     cloud backup; on Android 12+ device-to-device transfer needs these rules as well. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
